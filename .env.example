# Anthropic (Claude) API key — enables the REAL AI copilot, briefings,
# incident reports, and route advice. Without it, the app gracefully falls
# back to deterministic mock responses so the demo always works.
#
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional — Groq (Llama) for some agent / self-service flows.
# Get a key at https://console.groq.com/
GROQ_API_KEY=
